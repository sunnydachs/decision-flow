# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# The loader resolves keys in this order: process env → repo `.env`.
# Values are never written to logs, results, or reports.

# 比較用 LLM(models.llm.key_env の既定)。経路は config/local.toml で設定する。
LLM_API_KEY=
# mercury(評価対象の Decision Model。models.mercury.key_env の既定)
DECIDER_API_KEY=
# jev(TypeSafe 公式)
TYPESAFE_API_KEY=
# pplx_decider(Perplexity)
PERPLEXITY_API_KEY=
